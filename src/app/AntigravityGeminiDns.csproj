<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>AntigravityGeminiDns</AssemblyName>
    <Version>1.1.0</Version>
    <Product>Antigravity-Gemini DNS</Product>
    <AssemblyTitle>Antigravity-Gemini DNS</AssemblyTitle>
    <Description>DNS bridge for Antigravity, Gemini and Google services on Windows</Description>
    <Copyright>MIT License</Copyright>
    <RootNamespace>AntigravityGeminiDns</RootNamespace>
    <!-- Without this, a build from a git checkout gets "1.1.0+<commit>" as InformationalVersion: the same sources then give different bytes with and without .git. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Preserve the complete WinForms/COM runtime; compress the portable file without trimming. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <!-- The engine scripts and the provider catalog live inside the exe; ScriptStore stages them with an ACL and SHA-256 check. -->
    <EmbeddedResource Include="Engine.ps1" LogicalName="Engine.ps1" />
    <EmbeddedResource Include="Integration.ps1" LogicalName="Integration.ps1" />
    <EmbeddedResource Include="EmergencyRestore.ps1" LogicalName="EmergencyRestore.ps1" />
    <EmbeddedResource Include="profiles.json" LogicalName="profiles.json" />
    <EmbeddedResource Include="Assets/Antigravity.png" LogicalName="Service.Antigravity.png" />
    <EmbeddedResource Include="Assets/Gemini.png" LogicalName="Service.Gemini.png" />
  </ItemGroup>
</Project>
